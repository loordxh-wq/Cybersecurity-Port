{
  "name": "eli-saad-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "check:i18n": "node scripts/check-messages.mjs",
    "lint": "npm run check:i18n && next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:i18n && next build",
    "start": "next start",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "motion": "12.12.1",
    "next": "15.3.3",
    "next-intl": "4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.8",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "eslint": "9.28.0",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3"
  }
}
